# Copy to .env and adjust values.
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uzhavan

# JWT signing secret — MUST be set to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS: "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50
OTP_RATE_LIMIT_MAX=10

# Include the OTP code in the API response (dev/demo only — never true in production).
# In production this is where an SMS provider (MSG91 / Twilio / etc.) would be called.
OTP_DEBUG=true

# Number of trust proxies in front of the app (1 behind a reverse proxy / render / heroku)
TRUST_PROXY=1
